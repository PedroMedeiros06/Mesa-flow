# Copie para .env e preencha. O .env nunca vai para o Git.

# Backend
PORT=3000
# Origens liberadas no CORS, separadas por vírgula
FRONTEND_URL=http://localhost:5173
# Em produção atrás de proxy (Render, Railway): 1. Deixe vazio rodando local.
TRUST_PROXY=

# Supabase Auth. URL e chave publicável são públicas (podem ir para o front).
SUPABASE_URL=https://anujomdyzlkpcakbuwhx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_1IOpCDl_HFF-LfPdLHjY3w_feZq5Vrk
# Chave secreta (Dashboard > Project Settings > API Keys > Secret keys, começa com sb_secret_).
# Só os scripts de cadastro usam. Nunca vai para o front nem para o Git.
SUPABASE_SECRET_KEY=

# Conexão com o Postgres do Supabase (Dashboard > Connect > "Session pooler", porta 5432).
# Use o Session pooler: a "Direct connection" só funciona em redes com IPv6.
# Troque [YOUR-PASSWORD] pela senha do banco. Nunca commite este valor.
DATABASE_URL=
